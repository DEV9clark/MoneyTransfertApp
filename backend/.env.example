APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# false en production !
APP_DEBUG=true
APP_URL=http://localhost

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=money_transfert
DB_USERNAME=postgres
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# --- Sécurité ---
# durée de vie des jetons mobile (minutes)
SANCTUM_TOKEN_EXPIRATION=10080
# liste séparée par des virgules
CORS_ALLOWED_ORIGINS=http://localhost
ADMIN_DEFAULT_EMAIL=admin@moneytransfer.com
# vide = mot de passe aléatoire affiché au seed
ADMIN_DEFAULT_PASSWORD=

# --- SMS ---
# Prestataires essayés dans l'ordre (le second sert de secours)
SMS_DRIVERS=dexnotify,dexchange
DEXNOTIFY_URL=https://api.dexnotify.com/api
DEXNOTIFY_API_KEY=
DEXNOTIFY_SENDER=DEXCHANGE
# WhatsApp facultatif : copie du code de retrait (modèle Meta à 4 variables : montant, expéditeur, référence, code)
DEXNOTIFY_WHATSAPP_ACCOUNT_ID=
DEXNOTIFY_WHATSAPP_WITHDRAWAL_TEMPLATE=
# Ancienne API Dexchange (secours)
DEXCHANGE_API_KEY=
DEXCHANGE_SIGNATURE=DEXCONNECT

# --- Règles des transferts ---
TRANSFER_CODE_LENGTH=8
TRANSFER_CODE_TTL_DAYS=30
TRANSFER_MAX_CODE_ATTEMPTS=5
TRANSFER_MAX_AMOUNT=2000000
TRANSFER_DAILY_LIMIT_PER_CLIENT=3000000
TRANSFER_REQUIRE_SENDER_ID=false
# true UNIQUEMENT en dev sans SMS
TRANSFER_SHOW_CODE_TO_AGENT=false

# --- En-tête des reçus PDF ---
COMPANY_NAME="Money Transfer"
COMPANY_ADDRESS="Dakar, Sénégal"
COMPANY_PHONE=
COMPANY_EMAIL=
COMPANY_LEGAL="NINEA ... - RCCM ..."
